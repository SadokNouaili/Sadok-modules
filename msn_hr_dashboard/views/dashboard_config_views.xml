<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_msn_hr_dashboard_config_form" model="ir.ui.view">
        <field name="name">hr.dashboard.config.form</field>
        <field name="model">hr.dashboard.config</field>
        <field name="arch" type="xml">
            <form string="Dashboard Configuration">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Branding">
                            <field name="dashboard_title"/>
                            <field name="dashboard_subtitle"/>
                            <field name="show_logo"/>
                            <field name="logo" widget="image" filename="logo_filename"/>
                            <field name="logo_filename" invisible="1"/>
                        </group>
                        <group string="Effects">
                            <field name="glass_opacity"/>
                            <field name="blur_intensity"/>
                            <field name="border_radius"/>
                            <field name="enable_animations"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Theme Colors">
                            <group>
                                <group string="Brand Colors">
                                    <field name="primary_color"/>
                                    <field name="secondary_color"/>
                                    <field name="accent_color"/>
                                </group>
                                <group string="Background Gradient">
                                    <field name="bg_gradient_start"/>
                                    <field name="bg_gradient_mid"/>
                                    <field name="bg_gradient_end"/>
                                </group>
                            </group>
                            <group>
                                <group string="Card Colors">
                                    <field name="card_color_1"/>
                                    <field name="card_color_2"/>
                                    <field name="card_color_3"/>
                                    <field name="card_color_4"/>
                                    <field name="card_color_5"/>
                                    <field name="card_color_6"/>
                                </group>
                                <group string="Text">
                                    <field name="text_color"/>
                                    <field name="text_muted_color"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_msn_hr_dashboard_config_list" model="ir.ui.view">
        <field name="name">hr.dashboard.config.list</field>
        <field name="model">hr.dashboard.config</field>
        <field name="arch" type="xml">
            <list string="Dashboard Configurations">
                <field name="name"/>
                <field name="dashboard_title"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_msn_hr_dashboard_config" model="ir.actions.act_window">
        <field name="name">Dashboard Configurations</field>
        <field name="res_model">hr.dashboard.config</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
