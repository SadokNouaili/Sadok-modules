<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Client action that loads the OWL dashboard component -->
    <record id="action_msn_hr_dashboard" model="ir.actions.client">
        <field name="name">HR Dashboard</field>
        <field name="tag">msn_hr_dashboard.dashboard</field>
    </record>

    <!-- Own top-level app menu (this module declares application: True) -->
    <menuitem id="menu_msn_hr_dashboard_root"
              name="HR Dashboard"
              web_icon="msn_hr_dashboard,static/description/icon.png"
              sequence="50"/>

    <!-- Dashboard view -->
    <menuitem id="menu_msn_hr_dashboard_main"
              name="Dashboard"
              parent="menu_msn_hr_dashboard_root"
              action="action_msn_hr_dashboard"
              sequence="10"/>

    <!-- Configuration submenu -->
    <menuitem id="menu_msn_hr_dashboard_config_root"
              name="Configuration"
              parent="menu_msn_hr_dashboard_root"
              sequence="90"/>

    <menuitem id="menu_msn_hr_dashboard_config"
              name="Dashboard Theme"
              parent="menu_msn_hr_dashboard_config_root"
              action="action_msn_hr_dashboard_config"
              sequence="10"/>
</odoo>

