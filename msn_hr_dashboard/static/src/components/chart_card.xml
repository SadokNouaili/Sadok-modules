<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="msn_hr_dashboard.ChartCard">
        <div t-att-class="'hr-chart-card glass hr-size-' + (props.size or 'md')">
            <div class="hr-chart-glow"/>
            <div class="hr-chart-head">
                <div>
                    <h3 class="hr-chart-title"><t t-esc="props.title"/></h3>
                    <p t-if="props.subtitle" class="hr-chart-sub"><t t-esc="props.subtitle"/></p>
                </div>
                <div class="hr-chart-badge"><t t-esc="props.type.toUpperCase()"/></div>
            </div>
            <div class="hr-chart-canvas-wrap">
                <canvas t-ref="canvas"/>
            </div>
        </div>
    </t>

</templates>
