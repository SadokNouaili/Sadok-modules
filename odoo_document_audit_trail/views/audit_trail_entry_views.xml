<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST -->
    <record id="view_audit_trail_entry_list" model="ir.ui.view">
        <field name="name">audit.trail.entry.list</field>
        <field name="model">audit.trail.entry</field>
        <field name="arch" type="xml">
            <list string="Audit Trail" create="false" edit="false" delete="false"
                  default_order="operation_date desc"
                  decoration-danger="operation_type == 'unlink'"
                  decoration-muted="followup_state == 'resolved'"
                  decoration-warning="followup_state in ('open','in_progress')">
                <field name="operation_date"/>
                <field name="operation_type"/>
                <field name="document_name"/>
                <field name="folder_name" optional="show"/>
                <field name="user_id"/>
                <field name="field_changes" optional="show"/>
                <field name="signer_id" optional="hide"/>
                <field name="sign_item_type" optional="hide"/>
                <field name="sign_item_value" optional="hide"/>
                <field name="followup_state" optional="show" widget="badge"
                       decoration-warning="followup_state in ('open','in_progress')"
                       decoration-success="followup_state == 'resolved'"/>
                <field name="assigned_user_id" optional="hide"/>
                <field name="ip_address" optional="hide"/>
                <field name="trail_id" optional="hide"/>
                <button name="action_flag_review" type="object"
                        icon="fa-flag" title="Flag for review"
                        invisible="followup_state != 'none'"/>
                <button name="action_assign_me" type="object"
                        icon="fa-user" title="Assign to me"
                        invisible="followup_state == 'in_progress'"/>
                <button name="action_resolve" type="object"
                        icon="fa-check" title="Resolve"
                        invisible="followup_state in ('none','resolved')"/>
            </list>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_audit_trail_entry_form" model="ir.ui.view">
        <field name="name">audit.trail.entry.form</field>
        <field name="model">audit.trail.entry</field>
        <field name="arch" type="xml">
            <form string="Audit Log" create="false">
                <header>
                    <button name="action_view_trail" type="object"
                            string="View Document Timeline" class="btn-primary"/>
                    <button name="action_view_document" type="object"
                            string="Open Document"
                            invisible="not document_id"/>
                    <button name="action_view_sign_request" type="object"
                            string="Open Sign Request"
                            invisible="not sign_request_id"/>
                    <field name="followup_state" widget="statusbar"
                           statusbar_visible="none,open,in_progress,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="display_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Action">
                            <field name="operation_type" readonly="1"/>
                            <field name="document_name" readonly="1"/>
                            <field name="document_id" readonly="1"/>
                            <field name="folder_name" readonly="1"/>
                            <field name="trail_id" readonly="1"/>
                        </group>
                        <group string="Who / When">
                            <field name="user_id" readonly="1"/>
                            <field name="operation_date" readonly="1"/>
                            <field name="ip_address" readonly="1"/>
                        </group>
                    </group>
                    <group string="Signature Detail"
                           invisible="not sign_request_id and not sign_item_id">
                        <field name="sign_request_id" readonly="1"/>
                        <field name="signer_id" readonly="1"/>
                        <field name="sign_item_id" readonly="1"/>
                        <field name="sign_item_type" readonly="1"/>
                        <field name="sign_item_value" readonly="1"/>
                    </group>
                    <group string="Changes">
                        <field name="field_changes" nolabel="1" readonly="1"/>
                    </group>
                    <group string="Follow-up">
                        <field name="assigned_user_id"/>
                        <field name="review_note" placeholder="Reviewer notes..."/>
                    </group>
                    <notebook>
                        <page string="Raw Data" groups="base.group_no_one">
                            <group>
                                <field name="old_values" readonly="1"/>
                                <field name="new_values" readonly="1"/>
                                <field name="notes" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SEARCH -->
    <record id="view_audit_trail_entry_search" model="ir.ui.view">
        <field name="name">audit.trail.entry.search</field>
        <field name="model">audit.trail.entry</field>
        <field name="arch" type="xml">
            <search string="Audit Trail">
                <field name="document_name"/>
                <field name="user_id"/>
                <field name="operation_type"/>
                <field name="folder_name"/>
                <field name="signer_id"/>
                <field name="trail_id"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[('operation_date','&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <filter name="last7" string="Last 7 Days"
                        domain="[('operation_date','&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="deletions" string="Deletions" domain="[('operation_type','=','unlink')]"/>
                <filter name="signatures" string="Signatures"
                        domain="[('operation_type','in',('sign_request','sign_completed','sign_item_added','sign_item_removed','sign_item_signed'))]"/>
                <separator/>
                <filter name="flagged" string="Needs Review"
                        domain="[('followup_state','in',('open','in_progress'))]"/>
                <filter name="assigned_me" string="Assigned to Me"
                        domain="[('assigned_user_id','=', uid)]"/>
                <group>
                    <filter name="group_op" string="Operation" context="{'group_by':'operation_type'}"/>
                    <filter name="group_user" string="User" context="{'group_by':'user_id'}"/>
                    <filter name="group_trail" string="Document" context="{'group_by':'trail_id'}"/>
                    <filter name="group_followup" string="Follow-up" context="{'group_by':'followup_state'}"/>
                    <filter name="group_date" string="Date" context="{'group_by':'operation_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- GRAPH -->
    <record id="view_audit_trail_entry_graph" model="ir.ui.view">
        <field name="name">audit.trail.entry.graph</field>
        <field name="model">audit.trail.entry</field>
        <field name="arch" type="xml">
            <graph string="Activity" type="bar" sample="1">
                <field name="operation_date" interval="day"/>
                <field name="operation_type"/>
            </graph>
        </field>
    </record>

    <!-- PIVOT -->
    <record id="view_audit_trail_entry_pivot" model="ir.ui.view">
        <field name="name">audit.trail.entry.pivot</field>
        <field name="model">audit.trail.entry</field>
        <field name="arch" type="xml">
            <pivot string="Activity" sample="1">
                <field name="user_id" type="row"/>
                <field name="operation_type" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_audit_trail" model="ir.actions.act_window">
        <field name="name">Audit Trail</field>
        <field name="res_model">audit.trail.entry</field>
        <field name="view_mode">list,graph,pivot,form</field>
        <field name="search_view_id" ref="view_audit_trail_entry_search"/>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No audit records yet</p>
            <p>Actions performed on documents will appear here.</p>
        </field>
    </record>

    <!-- Follow-up action (pre-filtered) -->
    <record id="action_audit_trail_followup" model="ir.actions.act_window">
        <field name="name">Follow-ups</field>
        <field name="res_model">audit.trail.entry</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_audit_trail_entry_search"/>
        <field name="domain">[('followup_state','in',('open','in_progress'))]</field>
        <field name="context">{'create': False, 'search_default_flagged': 1}</field>
    </record>

</odoo>
