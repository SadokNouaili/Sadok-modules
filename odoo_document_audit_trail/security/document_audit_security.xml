<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Odoo 19: groups are grouped via res.groups.privilege.
             The res.groups.category_id field was removed; the category now
             lives on the privilege, and each group points to the privilege
             through privilege_id. -->
        <record id="privilege_audit_trail" model="res.groups.privilege">
            <field name="name">Document Audit Trail</field>
            <field name="sequence">100</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>

        <record id="group_audit_trail_user" model="res.groups">
            <field name="name">Document Audit: Read Own</field>
            <field name="privilege_id" ref="privilege_audit_trail"/>
        </record>

        <record id="group_audit_trail_manager" model="res.groups">
            <field name="name">Document Audit: Manager</field>
            <field name="privilege_id" ref="privilege_audit_trail"/>
            <field name="implied_ids" eval="[(4, ref('group_audit_trail_user'))]"/>
        </record>

        <!-- Odoo 19: res.groups.users was removed; the relation is now set
             from the user side via group_ids. Grant the admin the manager
             group here. -->
        <record id="base.user_admin" model="res.users">
            <field name="group_ids" eval="[(4, ref('group_audit_trail_manager'))]"/>
        </record>

        <!-- Regular users only see logs of documents they performed actions on -->
        <record id="rule_audit_trail_own" model="ir.rule">
            <field name="name">Document Audit: own actions</field>
            <field name="model_id" ref="model_audit_trail_entry"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_audit_trail_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Managers see everything -->
        <record id="rule_audit_trail_all" model="ir.rule">
            <field name="name">Document Audit: all actions</field>
            <field name="model_id" ref="model_audit_trail_entry"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_audit_trail_manager'))]"/>
        </record>

        <!-- Trails: users see trails that contain at least one of their own
             entries; managers see all. -->
        <record id="rule_audit_trail_doc_own" model="ir.rule">
            <field name="name">Document Trail: own</field>
            <field name="model_id" ref="model_audit_trail"/>
            <field name="domain_force">[('entry_ids.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_audit_trail_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_audit_trail_doc_all" model="ir.rule">
            <field name="name">Document Trail: all</field>
            <field name="model_id" ref="model_audit_trail"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_audit_trail_manager'))]"/>
        </record>

    </data>
</odoo>
